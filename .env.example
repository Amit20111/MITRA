# Copy to .env at the repository root. Keys stay in the backend.
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=
LLM_API_KEY=
LLM_THINKING=false
LLM_TIMEOUT_SECONDS=120

# Agent is implemented. Speech adapters require explicit opt-in and speech-role URLs/models.
# LLM_AGENT_PROVIDER=local
# LLM_AGENT_BASE_URL=http://127.0.0.1:8080/v1
# LLM_AGENT_MODEL=your-model-alias
# LLM_AGENT_API_KEY=
# LLM_SUMMARIZER_MODEL=your-future-model
# The same PROVIDER/BASE_URL/MODEL/API_KEY suffixes work for
# LLM_SUMMARIZER_, LLM_EMBEDDER_, LLM_STT_, LLM_TTS_.

# Optional hosted comparison (explicitly opt in; no automatic fallback):
# LLM_AGENT_PROVIDER=hosted
# LLM_AGENT_BASE_URL=https://your-provider.example/v1
# LLM_AGENT_MODEL=your-hosted-model
# LLM_AGENT_API_KEY=

# Defaults to repository/workspace. Use an absolute directory you control.
# MITRA_WORKSPACE=E:/JARIS/workspace
# New schema; prior milestone databases are preserved separately.
# MITRA_DATABASE=E:/JARIS/.data/mitra-slice1.db
MITRA_MAX_STEPS=8
MITRA_STEP_RETRIES=1
MITRA_APPROVAL_SECONDS=600

# Browser session lifetime after opening a one-time `npm run unlock` link (1-720 hours).
MITRA_SESSION_HOURS=168
# The per-install local key defaults to %LOCALAPPDATA%\MITRA\local-api.key.
# Override only for isolated testing; the API and frontend must use the same value.
# MITRA_SECRET_DIR=C:/path/private/to/your/account

# Opt-in read-only browser. Empty means disabled; no browser starts at API startup.
# Exact trusted origins only. No wildcards, paths, credentials, or automatic subdomains.
# MITRA_BROWSER_ORIGINS=https://example.com,https://docs.example.com

# Frontend-only overrides belong in Frontend/.env.local or its shell:
# MITRA_API_URL=http://127.0.0.1:8000

# Optional sessions: every link click/text fill requires exact approval.
# Forms, passwords, uploads and page scripts remain blocked.
MITRA_BROWSER_INTERACTION=false

# Optional voice. Never starts/downloads a model; see docs/MEMORY_AND_VOICE.md.
MITRA_VOICE_ENABLED=false
# LLM_STT_PROVIDER=local
# LLM_STT_BASE_URL=http://127.0.0.1:8090/v1
# LLM_STT_MODEL=your-transcription-model
# LLM_STT_API_KEY=
# LLM_TTS_PROVIDER=local
# LLM_TTS_BASE_URL=http://127.0.0.1:8090/v1
# LLM_TTS_MODEL=your-speech-model
# LLM_TTS_API_KEY=
# MITRA_TTS_VOICE=your-provider-voice
